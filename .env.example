POSTGRES_PASSWORD=replace-with-long-random-bootstrap-secret
APP_DB_PASSWORD=replace-with-separate-long-random-runtime-secret
INTERNAL_API_KEY=replace-with-long-random-secret
# Separate 48+ character secret shared only by the trusted gateway signer and GAMMA API.
# Leave unset until the gateway contract and secret provisioning are approved.
GATEWAY_ASSERTION_SECRET=
GATEWAY_ASSERTION_ISSUER=gamma-gateway
GATEWAY_ASSERTION_AUDIENCE=aiops-gamma
GATEWAY_ASSERTION_MAX_TTL_SECONDS=60
ENABLE_OPENSEARCH=false
ENABLE_ALERT_INGESTION=false

# Canonical read-only adapters: OFF until upstream routes, ACL and tenant identity are qualified.
ENABLE_CANONICAL_READS=false
CANONICAL_READ_TOKEN=
CORE_READ_URL=
EVIDENCE_READ_URL=
TWIN_READ_URL=
